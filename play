#!/bin/sh
# Convenience shim so `./play sling` works on macOS and Linux.
# Prefers the repo's own .venv, because that is where requirements.txt is meant
# to be installed; falls back to python3 on PATH.
HERE="$(cd "$(dirname "$0")" && pwd)"
if [ -x "$HERE/.venv/bin/python" ]; then
    exec "$HERE/.venv/bin/python" "$HERE/play.py" "$@"
fi
exec python3 "$HERE/play.py" "$@"
